# Kopiere diese Datei zu .env und trage die Werte aus Supabase ein (Project Settings → API).
# .env wird NIE committet. Nur der "anon"/"publishable" Key gehört ins Frontend – niemals der service_role Key.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Nur für npm run db:migrate / db:query (NICHT fürs Frontend, daher ohne VITE_-Präfix).
# Persönlicher Token von https://supabase.com/dashboard/account/tokens – mit Ablaufdatum anlegen.
SUPABASE_ACCESS_TOKEN=sbp_dein-token
# Ablaufdatum des Tokens – npm run db:* warnt 7 Tage vorher
SUPABASE_ACCESS_TOKEN_EXPIRES=2026-12-09

# Eigener Mailversand für Bestätigungs-Mails (Brevo, kostenlos bis 300 Mails/Tag) – übernehmen mit npm run db:auth
# Werte aus Brevo → SMTP & API → SMTP. Absender muss in Brevo unter „Senders“ bestätigt sein.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=dein-login@smtp-brevo.com
SMTP_PASS=dein-smtp-schluessel
SMTP_SENDER_EMAIL=deine-bestaetigte@adresse.de
